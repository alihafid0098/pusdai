# Salin menjadi .env di server produksi, lalu isi nilainya.
APP_NAME="PUSDAI Jawa Barat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-kamu.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Cookie & sesi (aman untuk HTTPS)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & log
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database: SQLite paling mudah untuk hosting gratis.
# Untuk MySQL, ganti driver dan isi kredensial dari panel hosting.
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=pusdai
# DB_USERNAME=pusdai
# DB_PASSWORD=

# Chat AI (Gemini) - buat API key baru khusus produksi
# Chat AI: pilih provider. Kosongkan AI_PROVIDER untuk auto.
# - gemini  : pakai GEMINI_API_KEY
# - openai  : pakai AI_API_KEY + AI_BASE_URL (kompatibel OpenAI: Groq, OpenRouter, Together, DeepSeek)
# - local   : tanpa API, jawaban dari data PUSDAI
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Opsional: URL embed YouTube untuk siaran langsung Pusdai TV
YOUTUBE_LIVE_EMBED=

MAIL_MAILER=log


# Admin panel (/admin)
ADMIN_EMAIL=admin@pusdai.com
ADMIN_PASSWORD=password1234
